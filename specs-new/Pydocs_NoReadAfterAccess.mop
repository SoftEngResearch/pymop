{
  "Description": "Detects TOCTOU vulnerabilities. Using access() to check if a user is authorized to e.g. open a file before actually doing so using open() creates a security hole, because the user might exploit the short time interval between checking and opening the file to manipulate it",
  "Source": "https://docs.python.org/3.10/library/os.html#os.access",
  "Variables": {
    "checked_files": "set"
  },
  "Formalism": "fsm",
  "Formula": "s0 [use -> s1, check -> s2] s1 [use -> s1, check -> s2] s2 [use -> s3, check -> s2] s3 [use -> s3, check -> s2] alias match = s3",
  "Creation_Events": ["check"],
  "Events": {
    "After": {
      "check": [["os", "access"]],
      "use": [["builtins", "open"]]
    }
  },
  "Event_Actions": {
    "After": {
      "check": "self.checked_files.add(f)",
      "use": "return file in self.checked_files"
    }
  },
  "Handlers": {
    "match": "Security threat! Using access() to check if a user is authorized to open a file before actually doing so using open() creates a security hole."
  }
}
